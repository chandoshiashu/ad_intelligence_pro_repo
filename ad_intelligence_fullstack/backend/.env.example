# Required for live public Meta Ad Library collection through TinyFish
TINYFISH_API_KEY=replace_me

# true returns clearly marked sample records so the UI can be tested without API credits
DEMO_MODE=true

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# Optional; the default is the India public Meta Ad Library page
META_AD_LIBRARY_BASE_URL=https://www.facebook.com/ads/library/

# Optional: Gemini-powered evidence-grounded strategic summary
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
